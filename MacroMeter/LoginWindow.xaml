<Window x:Class="MacroMeter.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroMeter Login"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock Text="MacroMeter"
                       FontSize="26"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Meno"/>
            <TextBox x:Name="FirstNameBox" Margin="0,5,0,10"/>

            <TextBlock Text="Priezvisko"/>
            <TextBox x:Name="LastNameBox" Margin="0,5,0,10"/>

            <TextBlock Text="Email"/>
            <TextBox x:Name="EmailBox" Margin="0,5,0,10"/>

            <TextBlock Text="Heslo" Margin="0,-1,0,1"/>
            <PasswordBox x:Name="PassBox"/>
            
            <Button Content="Prihlásiť"
                    Height="40"
                    Background="Green"
                    Foreground="White"
                    Click="Login_Click"/>

            <Button Content="Registrovať sa"
                    Height="40"
                    Background="Blue"
                    Foreground="White"
                    Margin="0,10,0,0"
                    Click="Register_Click"/>

        </StackPanel>

    </Grid>
</Window>
