<Window x:Class="MacroMeter.FoodSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vyhľadávanie jedla"
        Height="400"
        Width="350"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="Vyhľadávanie jedla"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Názov jedla"
           FontWeight="Bold"
           Margin="0,0,0,5"/>

        <TextBox x:Name="FoodBox"
         Height="35"
         Margin="0,0,0,10"/>

        <Button Content="Hľadať"
                Height="40"
                Click="Search_Click"/>

        <TextBlock x:Name="ResultText"
                   Margin="0,20,0,0"
                   FontSize="16"
                   TextWrapping="Wrap"/>

    </StackPanel>
</Window>
