<Window x:Class="MacroMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroMeter"
        Height="762"
        Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <StackPanel Margin="20">

        <TextBlock Text="MacroMeter"
               FontSize="32"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,10,0,20"/>

        <TextBlock x:Name="WelcomeText"
               FontSize="24"
               FontWeight="Bold"
               Margin="0,0,0,20"/>

        <!-- DASHBOARD -->

        <Border Background="White"
            CornerRadius="10"
            Padding="15"
            Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="📊 Osobný Dashboard"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

                <TextBlock x:Name="WeightText"
                       FontSize="16"
                       Margin="0,5"/>

                <TextBlock x:Name="GoalWeightText"
                       FontSize="16"
                       Margin="0,5"/>

                <TextBlock x:Name="BMIText"
                       FontSize="16"
                       Margin="0,5"/>

                <TextBlock x:Name="CaloriesText"
                       FontSize="16"
                       Margin="0,5"/>

            </StackPanel>
        </Border>

        <Button Content="🔍 Vyhľadať jedlo"
            Height="50"
            Margin="0,5"
            Click="SearchFood_Click"/>

        <Button Content="📊 Denný príjem"
            Height="50"
            Margin="0,5"
            Click="DailyIntake_Click"/>

        <Button Content="➕ Pridať vlastné jedlo"
            Height="50"
            Margin="0,5"
            Click="AddFood_Click"/>

        <Button Content="👤 Profil používateľa"
            Height="50"
            Margin="0,5"
            Click="Profile_Click"/>

        <Button Content="⚙️ Nastavenia"
            Height="50"
            Margin="0,5"
            Click="Settings_Click"/>

        <Button Content="🚪 Odhlásiť sa"
            Height="50"
            Margin="0,20,0,0"
            Background="Red"
            Foreground="White"
            Click="Logout_Click"/>


    </StackPanel>

</Window>
