<Window x:Class="MacroMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroMeter" 
        Height="750" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        FontFamily="Segoe UI"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCE1E8"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D4E63"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="MACROMETER" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Separator Margin="30,10" Background="#3D4E63"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,10">
                    <Button x:Name="MenuDashboardBtn" Content="🔍 Dashboard" Style="{StaticResource MenuButtonStyle}" Click="SearchFood_Click"/>
                    <Button x:Name="MenuZapisatPrijemBtn" Content="🍽️ Zapísať príjem" Style="{StaticResource MenuButtonStyle}" Click="ZapisatPrijemMenu_Click"/>
                    <Button x:Name="MenuDailyIntakeBtn" Content="📊 Denný príjem" Style="{StaticResource MenuButtonStyle}" Click="DailyIntake_Click"/>
                    <Button x:Name="MenuAddFoodBtn" Content="➕ Pridať jedlo do DB" Style="{StaticResource MenuButtonStyle}" Click="AddFood_Click"/>
                    <Button x:Name="MenuProfileBtn" Content="👤 Profil" Style="{StaticResource MenuButtonStyle}" Click="Profile_Click"/>
                </StackPanel>

                <Button Grid.Row="2" Content="🚪 Odhlásiť sa" 
                        Background="#E74C3C" Foreground="White" 
                        Margin="15" FontWeight="Bold" Height="45"
                        Click="Logout_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1">

            <ScrollViewer x:Name="DashboardSection" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock x:Name="WelcomeText" Text="Ahoj! 👋" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="10,0,0,5"/>
                    <TextBlock Text="Dnes máte skvelý nábeh na splnenie cieľov." FontSize="14" Foreground="#7F8C8D" Margin="12,0,0,25"/>

                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource DashboardCard}">
                            <StackPanel>
                                <TextBlock Text="Kalórie dnes" Foreground="#95A5A6" FontSize="14"/>
                                <TextBlock x:Name="CaloriesText" Text="0 / 0 kcal" FontSize="22" FontWeight="Bold" Margin="0,5" Foreground="#2C3E50"/>
                                <TextBlock x:Name="RemainingCaloriesText" Text="Zostáva doplniť 0 kcal" FontSize="12" Foreground="#E67E22" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCard}">
                            <StackPanel>
                                <TextBlock Text="Aktuálna váha" Foreground="#95A5A6" FontSize="14"/>
                                <TextBlock x:Name="WeightText" Text="0.0 kg" FontSize="26" FontWeight="Bold" Margin="0,5" Foreground="#2C3E50"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox x:Name="NewWeightInput" Width="70" Height="28" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,5,0"/>
                                    <Button Content="Zapísať" Click="RecordWeight_Click" Width="70" Height="28" Background="#3498DB" Foreground="White" FontWeight="Bold">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCard}">
                            <StackPanel>
                                <TextBlock Text="BMI Index" Foreground="#95A5A6" FontSize="14"/>
                                <TextBlock x:Name="BMIText" Text="0.0" FontSize="26" FontWeight="Bold" Margin="0,5" Foreground="#2C3E50"/>
                                <TextBlock Text="Vypočítané z profilu" FontSize="12" Foreground="#3498DB" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardCard}">
                            <StackPanel>
                                <TextBlock Text="Cieľová váha" Foreground="#95A5A6" FontSize="14"/>
                                <TextBlock x:Name="TargetWeightText" Text="0.0 kg" FontSize="26" FontWeight="Bold" Margin="0,5" Foreground="#2C3E50"/>
                                <ProgressBar x:Name="MainProgressBar" Value="0" Height="8" Margin="0,5" Background="#ECF0F1" Foreground="#3498DB"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource DashboardCard}" Height="230" Margin="10,15,10,10">
                        <Grid>
                            <TextBlock x:Name="NoChartDataText" Text="📈 Sem sa vykreslí graf po zadaní aspoň 2 hodnôt váhy." 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BDC3C7" FontStyle="Italic"/>
                            <Canvas x:Name="WeightChartCanvas" Margin="10,20,10,20" Background="Transparent"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ZapisatPrijemSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock Text="🍽️ Zapísať jedlo do príjmu" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="10,0,0,25"/>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="1. Vyberte čas dňa:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ComboTimeline" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Raňajky" IsSelected="True"/>
                                <ComboBoxItem Content="Desiata"/>
                                <ComboBoxItem Content="Obed"/>
                                <ComboBoxItem Content="Olovrant"/>
                                <ComboBoxItem Content="Večera"/>
                                <ComboBoxItem Content="Druhá večera"/>
                            </ComboBox>

                            <TextBlock Text="2. Vyhľadajte jedlo v databáze:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="FoodSearchBox" Height="35" Margin="0,0,0,10" Padding="5,5" TextChanged="FoodSearchBox_TextChanged"/>

                            <ListBox x:Name="DatabaseListBox" Height="180" Margin="0,0,0,15" Background="#F8F9FA">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="600">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Nazov}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Kalorie, StringFormat={}{0} kcal}" Margin="5,0" Foreground="#7F8C8D" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Bielkoviny, StringFormat={}B: {0}g}" Margin="5,0" Foreground="#E67E22"/>
                                                <TextBlock Text="{Binding Sacharidy, StringFormat={}S: {0}g}" Margin="5,0" Foreground="#3498DB"/>
                                                <TextBlock Text="{Binding Tuky, StringFormat={}T: {0}g}" Margin="5,0" Foreground="#27AE60"/>
                                                <TextBlock Text="(na 100g)" Margin="8,0,0,0" Foreground="#BDC3C7" FontSize="11" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="3. Množstvo v gramoch (g):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="GramazInput" Height="35" Margin="0,0,0,20" Padding="5,5"/>

                            <Button Content="ZAPÍSAŤ DO PRÍJMU" Click="ConfirmZapisPrijmu_Click" Height="45" Background="#2C3E50" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DailyIntakeSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock Text="📊 Detailný denný príjem" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="10,0,0,25"/>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Dnešné makroživiny" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            <UniformGrid Columns="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Bielkoviny" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ProteinsText" Text="0g / 0g" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Sacharidy" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="CarbsText" Text="0g / 0g" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Tuky" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="FatsText" Text="0g / 0g" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AddFoodSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock Text="➕ Vytvoriť nové jedlo v šablónach (na 100g)" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="10,0,0,25"/>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock Text="Názov jedla" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="FoodNameInput" Height="35" Margin="0,0,0,15" Padding="5,5"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,15">
                                    <TextBlock Text="Kalórie (kcal na 100g)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="CaloriesInput" Height="35" Padding="5,5"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,15">
                                    <TextBlock Text="Množstvo (vždy 100g)" IsEnabled="False" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="AmountInput" Text="100" IsEnabled="False" Height="35" Padding="5,5" Background="#F0F2F5"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Bielkoviny (g na 100g)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="ProteinsInput" Height="35" Margin="0,0,0,15" Padding="5,5"/>

                            <TextBlock Text="Sacharidy (g na 100g)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="CarbsInput" Height="35" Margin="0,0,0,15" Padding="5,5"/>

                            <TextBlock Text="Tuky (g na 100g)" FontWeight="SemiBold" Margin="0,0,0,25" Padding="5,5"/>
                            <TextBox x:Name="FatsInput" Height="35" Margin="0,0,0,25" Padding="5,5"/>

                            <Button Content="ULOŽIŤ DO DATABÁZY" Click="SaveFood_Click" Height="45" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ProfileSection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30">
                    <TextBlock Text="👤 Môj Profil" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="10,0,0,25"/>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <TextBlock x:Name="ProfileFullName" Text="Meno Priezvisko" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="ProfileEmail" Text="email@priklad.com" Foreground="#7F8C8D" Margin="0,0,0,20"/>

                            <Separator Margin="0,10"/>

                            <UniformGrid Columns="2">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Vek" Opacity="0.6"/>
                                    <TextBlock x:Name="ProfileAge" Text="--" FontSize="16" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Margin="10">
                                    <TextBlock Text="Výška" Opacity="0.6"/>
                                    <TextBlock x:Name="ProfileHeight" Text="--" FontSize="16" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Margin="10">
                                    <TextBlock Text="Aktivita" Opacity="0.6"/>
                                    <TextBlock x:Name="ProfileActivity" Text="--" FontSize="16" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Margin="10">
                                    <TextBlock Text="Cieľ" Opacity="0.6"/>
                                    <TextBlock x:Name="ProfileGoal" Text="--" FontSize="16" FontWeight="Medium"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Button Content="✕" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Width="40" 
                    Height="40" 
                    Background="Transparent" 
                    Foreground="#2C3E50" 
                    FontSize="20" 
                    FontWeight="Bold" 
                    BorderThickness="0" 
                    Click="CloseWindow_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E74C3C"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>