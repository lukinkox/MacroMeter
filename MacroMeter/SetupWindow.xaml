<Window x:Class="MacroMeter.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup"
        Height="600"
        Width="420"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="25">

            <TextBlock Text="Setup"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Pohlavie"/>
            <ComboBox x:Name="GenderBox" Height="30">
                <ComboBoxItem Content="Muž"/>
                <ComboBoxItem Content="Žena"/>
            </ComboBox>

            <TextBlock Text="Vek" Margin="0,10,0,0"/>
            <TextBox x:Name="AgeBox" Height="30"/>

            <TextBlock Text="Výška" Margin="0,10,0,0"/>
            <TextBox x:Name="HeightBox" Height="30"/>

            <TextBlock Text="Aktivita" Margin="0,10,0,0"/>
            <ComboBox x:Name="ActivityBox" Height="30">
                <ComboBoxItem Content="Sedavý"/>
                <ComboBoxItem Content="Aktívny"/>
                <ComboBoxItem Content="Veľmi aktívny"/>
            </ComboBox>

            <TextBlock Text="Cieľ" Margin="0,10,0,0"/>
            <Border CornerRadius="10"
        BorderBrush="Gray"
        BorderThickness="1"
        Background="White">

                <ComboBox x:Name="GoalBox"
              BorderThickness="0"
              Background="Transparent"
              Padding="5">
                    <ComboBoxItem Content="Schudnúť"/>
                    <ComboBoxItem Content="Udržať"/>
                    <ComboBoxItem Content="Pribrať"/>
                </ComboBox>

            </Border>

            <Button Content="Registrovať sa"
                    Height="40"
                    Background="Green"
                    Foreground="White"
                    Margin="0,20,0,0"
                    Click="Save_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="15"
                    Background="{TemplateBinding Background}">
                            <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </StackPanel>
    </ScrollViewer>

</Window>