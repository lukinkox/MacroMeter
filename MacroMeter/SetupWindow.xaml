<Window x:Class="MacroMeter.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroMeter - Nastavenie profilu"
        Height="720" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        FontFamily="Segoe UI"
                WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0F2F5" Offset="0"/>
                <GradientStop Color="#DCE1E8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="35">

                <TextBlock Text="Osobný profil"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Nastavte si svoje parametre pre presný výpočet."
                           FontSize="13"
                           Foreground="#7F8C8D"
                           Margin="0,0,0,25"/>

                <Border Background="White" CornerRadius="15" Padding="25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.1"/>
                    </Border.Effect>

                    <StackPanel>
                        <!-- Pohlavie -->
                        <TextBlock Text="Pohlavie" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="12"/>
                        <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15">
                            <ComboBox x:Name="GenderBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0">
                                <ComboBoxItem Content="Muž"/>
                                <ComboBoxItem Content="Žena"/>
                            </ComboBox>
                        </Border>

                        <!-- Vek -->
                        <TextBlock Text="Vek" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="12"/>
                        <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15">
                            <TextBox x:Name="AgeBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                        </Border>

                        <!-- Váha Grid -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Aktuálna váha (kg)" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="11"/>
                                <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8">
                                    <TextBox x:Name="CurrentWeightBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cieľová váha (kg)" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="11"/>
                                <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8">
                                    <TextBox x:Name="GoalWeightBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Výška -->
                        <TextBlock Text="Výška (cm)" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="12"/>
                        <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15">
                            <TextBox x:Name="HeightBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                        </Border>

                        <!-- Aktivita -->
                        <TextBlock Text="Úroveň aktivity" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="12"/>
                        <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15">
                            <ComboBox x:Name="ActivityBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0">
                                <ComboBoxItem Content="Sedavý (minimálny pohyb)"/>
                                <ComboBoxItem Content="Ľahko aktívny (tréning 1-3x týždenne)"/>
                                <ComboBoxItem Content="Aktívny (tréning 4-5x týždenne)"/>
                                <ComboBoxItem Content="Veľmi aktívny (každodenný výdaj)"/>
                            </ComboBox>
                        </Border>

                        <TextBlock Text="Preferovaný štýl diéty" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="12"/>
                        <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8" Margin="0,0,0,30">
                            <ComboBox x:Name="DietBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0">
                                <ComboBoxItem Content="Vyvážená (Racionálna)"/>
                                <ComboBoxItem Content="Nízkosacharidová (Low Carb)"/>
                                <ComboBoxItem Content="Ketogénna (Keto)"/>
                                <ComboBoxItem Content="Vysokobielkovinová (High Protein)"/>
                            </ComboBox>
                        </Border>
                        
                        <TextBlock Text="Váš cieľ" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="12"/>
                        <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8" Margin="0,0,0,30">
                            <ComboBox x:Name="GoalBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0">
                                <ComboBoxItem Content="Schudnúť"/>
                                <ComboBoxItem Content="Udržať váhu"/>
                                <ComboBoxItem Content="Pribrať svaly"/>
                            </ComboBox>
                        </Border>

                        <Button x:Name="FinishButton"
                                Content="DOKONČIŤ NASTAVENIE"
                                Height="50"
                                Background="#2C3E50"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="14"
                                Cursor="Hand"
                                Click="Save_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#34495E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Text="Krok 2 z 2" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,20,0,0" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>