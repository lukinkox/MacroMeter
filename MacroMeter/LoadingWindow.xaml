<Window x:Class="MacroMeter.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Načítavam..." Height="350" Width="500"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent"
                WindowState="Maximized"
        ResizeMode="NoResize">

    <Border Background="#2C3E50" CornerRadius="20">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🍎" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="MACROMETER" Foreground="White" FontSize="26" 
                           FontWeight="Bold" HorizontalAlignment="Center"/>

                <TextBlock Text="Váš osobný asistent výživy" Foreground="#BDC3C7" 
                           FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,30"/>

                <ProgressBar x:Name="LoadingBar" x:FieldModifier="public" Width="350" Height="10" 
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="#3498DB" Background="#3D4E63" BorderThickness="0">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>

                <TextBlock x:Name="StatusText" x:FieldModifier="public" Text="Načítavam databázu..." 
                           Foreground="White" FontSize="12" Opacity="0.7"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>

                <TextBlock x:Name="PercentText" x:FieldModifier="public" Text="0%" 
                           Foreground="White" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>