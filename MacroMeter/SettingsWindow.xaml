<Window x:Class="MacroMeter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nastavenia"
        Height="300"
        Width="300"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">

        <TextBlock Text="Nastavenia"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <CheckBox Content="Tmavý režim"
                  Margin="0,10"/>

        <CheckBox Content="Notifikácie"
                  Margin="0,10"/>

        <Button Content="Uložiť"
                Height="40"
                Margin="0,20,0,0"
                Click="Save_Click"/>


    </StackPanel>
</Window>
