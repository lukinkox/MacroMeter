<Window x:Class="MacroMeter.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroMeter - Registrácia"
        Height="650" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        FontFamily="Segoe UI"
                WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0F2F5" Offset="0"/>
                <GradientStop Color="#DCE1E8" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Button Content="✕" 
        HorizontalAlignment="Right" 
        VerticalAlignment="Top" 
        Width="40" 
        Height="40" 
        Background="Transparent" 
        Foreground="#2C3E50" 
        FontSize="20" 
        FontWeight="Bold" 
        BorderThickness="0" 
        Click="CloseWindow_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#E74C3C"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="35">

                <TextBlock Text="Vytvoriť účet"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Zaregistrujte sa a začnite sledovať svoje makrá."
                           FontSize="13"
                           Foreground="#7F8C8D"
                           Margin="0,0,0,25"/>

                <Border Background="White" CornerRadius="15" Padding="25">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.1"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Meno" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="12"/>
                                <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8">
                                    <TextBox x:Name="MenoBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Priezvisko" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5" FontSize="12"/>
                                <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8">
                                    <TextBox x:Name="PriezviskoBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Email" Foreground="#34495E" FontWeight="SemiBold" Margin="0,15,0,5" FontSize="12"/>
                        <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8">
                            <TextBox x:Name="EmailBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" TextChanged="EmailBox_TextChanged"/>
                        </Border>

                        <TextBlock Text="Heslo" Foreground="#34495E" FontWeight="SemiBold" Margin="0,15,0,5" FontSize="12"/>
                        <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8">
                            <PasswordBox x:Name="PassBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                        </Border>

                        <TextBlock Text="Potvrď heslo" Foreground="#34495E" FontWeight="SemiBold" Margin="0,15,0,5" FontSize="12"/>
                        <Border BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="8">
                            <PasswordBox x:Name="ConfirmBox" Height="35" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                        </Border>

                        <CheckBox x:Name="TermsCheckBox" Margin="0,20,0,20">
                            <TextBlock Text="Súhlasím s podmienkami používania" Foreground="#7F8C8D" FontSize="12" VerticalAlignment="Center"/>
                        </CheckBox>

                        <Button Content="POKRAČOVAŤ"
                                Height="45"
                                Background="#2C3E50"
                                Foreground="White"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="Register_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

                <Button Content="Už máte účet? Prihláste sa" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="#3498DB" 
                        Margin="0,20,0,0" 
                        Cursor="Hand"
                        HorizontalAlignment="Center" Click="Button_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>