<Window x:Class="MacroMeter.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register"
        Height="550"
        Width="420"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="25">

            <TextBlock Text="Registrácia"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Meno"/>
            <TextBox x:Name="MenoBox" Height="30"/>

            <TextBlock Text="Priezvisko" Margin="0,10,0,0"/>
            <TextBox x:Name="PriezviskoBox" Height="30"/>

            <TextBlock Text="Email" Margin="0,10,0,0"/>
            <TextBox x:Name="EmailBox" Height="30"/>

            <TextBlock Text="Heslo" Margin="0,10,0,0"/>
            <PasswordBox x:Name="PassBox" Height="30"/>

            <TextBlock Text="Potvrď heslo" Margin="0,10,0,0"/>
            <PasswordBox x:Name="ConfirmBox" Height="30"/>

            <CheckBox x:Name="TermsCheckBox"
                      Content="Súhlasím s podmienkami"
                      Margin="0,15,0,15"/>

            <Button Content="Pokračovať"
                    Height="40"
                    Background="Green"
                    Foreground="White"
                    Click="Register_Click"/>

        </StackPanel>
    </ScrollViewer>

</Window>
